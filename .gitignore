# Python cache/bytecode
__pycache__/
*.py[cod]
*$py.class

# Build/distribution
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Conda
.conda/
conda-meta/

# Testing/coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# OS/filesystem
.DS_Store
Thumbs.db

# Local env/config files
.env
.env.*

# Runtime/logs
*.log

# Markdown docs (repo intentionally code-only)
*.md

# Project artifacts generated by pipeline
artifacts/*
!artifacts/.gitkeep

# Local data outputs (keep sample raw data under data/raw)
data/processed/

# Local docs / evaluation drafts (do not version)
importante/

# Windows ADS metadata files accidentally copied on Linux
*:Zone.Identifier
